# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
DATABASE_URL="postgresql://toktickit:toktickit@localhost:5432/toktickit?schema=public"
PORT=3000

# Issue 3 — Authentication
# Signs the express-session cookie. Generate your own long random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET="replace-with-a-long-random-value"
# Origin of the Vite dev server. Must match exactly (scheme + host + port)
# for the browser to accept the session cookie via CORS.
CLIENT_ORIGIN="http://localhost:5173"
